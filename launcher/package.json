{
  "name": "generation-launcher",
  "productName": "The Last New Year",
  "version": "0.2.0",
  "description": "Launcher for The Last New Year (GENERATION modpack)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2"
  },
  "dependencies": {
    "@xmcl/core": "^2.16.3",
    "adm-zip": "^0.6.1"
  },
  "build": {
    "appId": "com.thelastnewyear.launcher",
    "productName": "The Last New Year",
    "files": [
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "TheLastNewYear-${version}-${arch}.${ext}"
  }
}